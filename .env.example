# ==============================================================================
# ONE SCHOOL SOLUTION - BACKEND EMAIL SERVICE CONFIGURATION (.env)
# ==============================================================================

# Target email to receive demo notifications (Default: onesolution9880@gmail.com)
RECEIVING_EMAIL=onesolution9880@gmail.com

# OPTION 1: Gmail App Password (Recommended for Google Workspace / Gmail)
# Generate a 16-character app password at: https://myaccount.google.com/apppasswords
# GMAIL_USER=onesolution9880@gmail.com
# GMAIL_APP_PASS=abcd efgh ijkl mnop

# OPTION 2: Custom Institutional SMTP Server (e.g. AWS SES, SendGrid, Hostinger, Office365)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=onesolution9880@gmail.com
# SMTP_PASS=your-smtp-password
# SMTP_SECURE=false

# Port for local Node.js backend
PORT=3000

